/*
 * STAR index settings for reuse by Parabricks rna_fq2bam.
 *
 * Parabricks 4.6.0-1 expects the STAR 2.7.2a genomeParameters.txt
 * format. Keep this separate from the ordinary STAR reference build,
 * which uses the newer STAR version supplied by nf-core/references.
 */
process {
    withName: '.*STAR.*GENOMEGENERATE.*' {
        // Keep the original Parabricks STAR resource request. The process
        // inherits the workflow retry policy so larger genomes can escalate
        // resources on subsequent attempts rather than imposing wheat-sized
        // allocations on every reference build.
        cpus    = 12
        memory  = '72.GB'
        time    = '16.h'
        // Biocontainers exposes the CPU STAR executable directly and this
        // image has been verified on Codon to report STAR version 2.7.2a,
        // which is the version compatible with Parabricks rna_fq2bam.
        container = 'quay.io/biocontainers/star:2.7.2a--0'
    }
}
